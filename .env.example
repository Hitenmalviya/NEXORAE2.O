# ==========================================
# NEXORAE 2.0 Frontend Environment Variables
# ==========================================
# Configure these variables in Vercel Project Settings > Environment Variables
#
# IMPORTANT:
# All VITE_* variables are embedded in the client build and PUBLIC.
# NEVER put private backend secrets, database URIs, or secret keys here.

# Backend API Endpoint URL
# Local Development: http://localhost:5000/api
# Production Vercel Deployment: https://your-backend-service.onrender.com/api
VITE_API_URL=https://your-backend-api-domain.com/api
